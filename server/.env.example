# Copy to server/.env and fill in. server/.env is gitignored — never commit a real key.
#
# relayer.js builds its provider from SEPOLIA_RPC_URL whatever the network is, so these
# same three variables point at either the deployed Sepolia contract or a local Hardhat
# node. For a local chain use http://127.0.0.1:8545, Hardhat account #0's key, and the
# address `npx hardhat run scripts/deploy.cjs --network localhost` prints.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=0x_relayer_private_key_here
CONTRACT_ADDRESS=0x_deployed_contract_address_here

PORT=5000

# MinIO / S3-compatible object storage. The bucket must be named court-records.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-before-first-run

# Salt for the AES-256-GCM key derivation in server/storage.js. Changing it makes
# every previously encrypted object undecryptable.
STORAGE_SECRET=veritas-secret-salt-2026
